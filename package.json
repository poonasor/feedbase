{
  "name": "feedbase",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "lint": "turbo run lint --",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "ts": "turbo run ts",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@feedbase/tailwind-config": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.57.1",
    "eslint-config-custom": "workspace:*",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "prettier": "3.0.3",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "turbo": "^2.11.6"
  },
  "packageManager": "pnpm@8.6.2",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "next@14.1.4": "14.2.35",
      "sharp": "^0.35.4",
      "ws@^8.0.0": "^8.22.0",
      "engine.io@^6.0.0": "^6.6.11",
      "micromatch@^4.0.0": "^4.0.8",
      "minimatch@^9.0.0": "^9.0.9",
      "yaml@^2.0.0": "^2.9.1",
      "prismjs@^1.0.0": "^1.30.0",
      "ajv@^6.0.0": "^6.15.0",
      "@babel/core@^7.0.0": "^7.29.7",
      "postcss": "8.5.28",
      "esbuild": "^0.28.2",
      "serialize-javascript": "^7.0.3"
    }
  }
}
